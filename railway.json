{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @michael/api build",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "pnpm-lock.yaml", "package.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @michael/api start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "multiRegionConfig": {
      "europe-west4-drams3a": {
        "numReplicas": 1
      }
    },
    "sleepApplication": false
  }
}
