{
  "name": "michael",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @michael/api --filter @michael/web dev",
    "dev:api": "pnpm --filter @michael/api dev",
    "dev:web": "pnpm --filter @michael/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint",
    "format": "biome check --write .",
    "env:copy": "node scripts/copy-env.mjs",
    "collect": "pnpm --silent --filter @michael/collector start",
    "start": "pnpm --filter @michael/api start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7"
  }
}
