{
  "name": "michael",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @michael/api --filter @michael/web dev",
    "dev:api": "pnpm --filter @michael/api dev",
    "dev:web": "pnpm --filter @michael/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint",
    "test": "pnpm -r --if-present test && node --test apps/extension/test/*.test.mjs scripts/shortcut/*.test.mjs",
    "format": "biome check --write .",
    "e2e": "NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_ANON_KEY=e2e-anon-key pnpm --filter @michael/web build && pnpm --filter @michael/e2e e2e",
    "categories:extension": "pnpm --filter @michael/api exec tsx scripts/extension-categories.ts",
    "env:copy": "node scripts/copy-env.mjs",
    "shortcut": "node scripts/shortcut/build.mjs --sign",
    "shortcut:focus": "node scripts/shortcut/build.mjs --sign --only-focus",
    "shortcut:inspect": "osascript -l JavaScript scripts/shortcut/inspect.jxa.js scripts/shortcut/out/Michael.shortcut",
    "collect": "pnpm --silent --filter @michael/collector start",
    "start": "pnpm --filter @michael/api start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7"
  }
}
