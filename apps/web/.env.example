# Copy to apps/web/.env.local for local dev. Only NEXT_PUBLIC_ vars reach the browser.
# Real data from API_URL by default. USE_MOCKS=true serves fixtures from @michael/shared instead
# (also the default in `next dev` when API_URL is unset). Screens preview the sample with ?demo=sample.
USE_MOCKS=
API_URL=http://localhost:8787
API_KEY=dev-key
# The presenter link's secret (#343): /auth/presenter?key=<value>, opened once on the presenting
# laptop, lets that browser tap Allow when claude.ai connects to the demo week. Same value as on the
# API. Generate with `openssl rand -base64 32 | tr -d '/+=' `. Empty = no presenter. Never commit it.
DEMO_PRESENTER_KEY=
# Optional: the MCP URL shown on the Agents screen. Empty = API_URL + /mcp.
MCP_URL=
# Supabase Auth (public by design: the anon key only works with RLS, all data goes through the API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: an iCloud link of the Michael shortcut (docs/sources/ios-shortcuts.md, "One tap set up").
# Empty: "Add the shortcut" downloads the signed file this app serves, /Michael.shortcut.
MICHAEL_SHORTCUT_URL=
# Optional: an iCloud link of the Michael Focus shortcut, the same way (docs/setup-manual.md, 8b).
# Empty: "Add Michael Focus" opens the signed file this app serves, /MichaelFocus.shortcut.
MICHAEL_FOCUS_SHORTCUT_URL=

# Pretend the API is slow (ms), to see and measure skeletons locally (lib/dev-latency.ts). Never set it in a deployment.
MOCK_LATENCY_MS=
