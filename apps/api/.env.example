# Copy to apps/api/.env for local dev. Never commit real values.
PORT=8787
# Shared secret for /v1/* and /mcp (Authorization: Bearer <API_KEY>). Provisional MVP auth.
API_KEY=dev-key
# on: the demo account (API_KEY) carries a generated week up to now (apps/api/src/demo). off: not.
DEMO_WEEK=on
# Comma-separated origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used for OAuth redirect URIs).
PUBLIC_API_URL=http://localhost:8787
# Public URL of the web app (MCP OAuth consent page). Empty = first non local WEB_ORIGIN.
PUBLIC_WEB_URL=
# Where the Mac installer (GET /v1/setup/mac.sh) downloads the collector from: a public GitHub repo and ref.
COLLECTOR_REPO=loukas-hackathon/michael-hachathon
COLLECTOR_REF=main
# Leave empty to use the in-memory store seeded with mock data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google AI (Gemini) for analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Web app URL the OAuth callbacks return to (defaults to the first WEB_ORIGIN).
WEB_URL=http://localhost:3000
# Google Calendar OAuth: a "Web application" client in Google Cloud. Authorised redirect URI:
# ${PUBLIC_API_URL}/v1/oauth/google_calendar/callback. Setup: docs/sources/google-calendar.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Minutes between background calendar syncs for every connected user (0 = off).
CALENDAR_SYNC_MINUTES=15
# Other OAuth apps (wired up by their issues).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Claude writes the analysis (POST /v1/analysis/run) and answers the chat. Never commit the value.
# Without a key those two routes answer 503 and the rest of the API works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Web Push for nudges (iPhone Home Screen app, Apple Watch mirror, browsers).
# Generate once with `npx web-push generate-vapid-keys`; the public key reaches the app via GET /v1/push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@michael.app
# Nudge check for every active user on an interval, inside the API process.
# Default: on when NODE_ENV=production, off locally. Set true or false to override.
SCHEDULER_ENABLED=
SCHEDULER_INTERVAL_MINUTES=5
# Google Maps Platform key for travel times (Routes API + Geocoding API). Server side only;
# restrict it to those two APIs. Empty = places are kept, travel is skipped.
GOOGLE_MAPS_API_KEY=
# Telegram bot for nudges, a backup to Web Push. Create the bot with @BotFather and paste its token.
# On start the API points the bot's webhook at ${PUBLIC_API_URL}/v1/webhooks/telegram (https only).
# Username empty = asked from Telegram; secret empty = derived from the token. Setup: docs/sources/telegram.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# ElevenLabs text to speech for Michael's voice (free tier). Empty = the browser's own voice.
ELEVENLABS_API_KEY=
# Default "George" (calm British male). "Daniel" (deep British) is onwK4e9ZLuTAKqWW03F9.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_flash_v2_5
