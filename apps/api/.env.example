# Copy to apps/api/.env for local dev. Never commit real values.
PORT=8787
# Shared secret for /v1/* and /mcp (Authorization: Bearer <API_KEY>). Provisional MVP auth.
API_KEY=dev-key
# Comma-separated origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Public URL of this API (used for OAuth redirect URIs).
PUBLIC_API_URL=http://localhost:8787
# Public URL of the web app (MCP OAuth consent page). Empty = first non local WEB_ORIGIN.
PUBLIC_WEB_URL=
# Leave empty to use the in-memory store seeded with mock data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google AI (Gemini) for analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Web app URL the OAuth callbacks return to (defaults to the first WEB_ORIGIN).
WEB_URL=http://localhost:3000
# Google Calendar OAuth: a "Web application" client in Google Cloud. Authorised redirect URI:
# ${PUBLIC_API_URL}/v1/oauth/google_calendar/callback. Setup: docs/sources/google-calendar.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Minutes between background calendar syncs for every connected user (0 = off).
CALENDAR_SYNC_MINUTES=15
# Other OAuth apps (wired up by their issues).
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Claude (analysis, chat). Never commit the value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
