{
  "name": "@michael/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --import ./src/test-env.ts --test \"src/**/*.test.ts\"",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/demo-week.ts",
    "analysis:brief": "tsx scripts/analysis-brief.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^2.1.8",
    "@michael/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.0",
    "hono": "^4.13.18",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
